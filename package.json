{
  "name": "yerbamate-desktop",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-syntax-highlighter": "^16.1.1",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.yerbamate.desktop",
    "productName": "YerbaMate",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "Pic/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "main.py",
        "to": "backend/main.py"
      },
      {
        "from": "sentinel",
        "to": "backend/sentinel",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "requirements.txt",
        "to": "backend/requirements.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "Pic/yerbamate.ico"
    },
    "nsis": {
      "installerIcon": "Pic/yerbamate.ico",
      "uninstallerIcon": "Pic/yerbamate.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "YerbaMate"
    }
  }
}
